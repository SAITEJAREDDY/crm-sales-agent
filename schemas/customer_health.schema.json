{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CustomerHealthCollection",
  "type": "object",
  "description": "Account-level rollups supplied by the operator.",
  "properties": {
    "generated_at": {
      "type": "string",
      "description": "Rollup generation timestamp."
    },
    "data_version": {
      "type": "string",
      "description": "Health format version."
    },
    "source_files": {
      "type": "array",
      "description": "Paths or references of the rollup inputs.",
      "items": {
        "type": "string",
        "description": "Text supplied by the data owner or generated by the workflow."
      }
    },
    "total_customers": {
      "type": "integer",
      "description": "Number of supplied customer records.",
      "x-unit": "count"
    },
    "status_counts": {
      "type": "object",
      "description": "Counts per health category.",
      "properties": {
        "red": {
          "type": "integer",
          "description": "Accounts requiring attention.",
          "x-unit": "count"
        },
        "amber": {
          "type": "integer",
          "description": "Accounts requiring monitoring.",
          "x-unit": "count"
        },
        "green": {
          "type": "integer",
          "description": "Healthy accounts.",
          "x-unit": "count"
        }
      }
    },
    "customers": {
      "type": "array",
      "description": "Account health records; no records are included.",
      "items": {
        "type": "object",
        "description": "Account health record.",
        "properties": {
          "customer_slug": {
            "type": "string",
            "description": "Stable account join key."
          },
          "account_info": {
            "type": "object",
            "description": "Account identifiers and portfolio classifications.",
            "properties": {
              "account_name": {
                "type": "string",
                "description": "Account display name."
              },
              "segment": {
                "type": "string",
                "description": "Account segment based on portfolio value."
              },
              "primary_rep": {
                "type": "string",
                "description": "Most frequently assigned representative."
              },
              "primary_product": {
                "type": "string",
                "description": "Most frequent product classification."
              }
            },
            "required": [
              "account_name"
            ]
          },
          "health": {
            "type": "object",
            "description": "Health assessment and supporting components.",
            "properties": {
              "score": {
                "type": "number",
                "description": "Derived health score.",
                "minimum": 0,
                "maximum": 100,
                "x-unit": "score"
              },
              "status": {
                "type": "string",
                "description": "Health category.",
                "enum": [
                  "red",
                  "amber",
                  "green"
                ]
              },
              "churn_risk_score": {
                "type": "number",
                "description": "Derived churn risk score.",
                "minimum": 0,
                "maximum": 100,
                "x-unit": "score"
              },
              "churn_risk": {
                "type": "string",
                "description": "Churn risk category."
              },
              "source_basis": {
                "type": "string",
                "description": "Description of the evidence or inference used."
              }
            }
          },
          "program": {
            "type": "object",
            "description": "Customer program context.",
            "properties": {
              "current_stage": {
                "type": "integer",
                "description": "Current customer program stage.",
                "minimum": 1,
                "x-unit": "count"
              },
              "stage_name": {
                "type": "string",
                "description": "Current program stage name."
              },
              "stage_owner": {
                "type": "string",
                "description": "Role responsible for the stage."
              },
              "stage_history": {
                "type": "array",
                "description": "Program stages and their progression states.",
                "items": {
                  "type": "object",
                  "description": "Program stage state.",
                  "properties": {
                    "stage": {
                      "type": "integer",
                      "description": "Program stage order.",
                      "minimum": 1,
                      "x-unit": "count"
                    },
                    "stage_name": {
                      "type": "string",
                      "description": "Program stage name."
                    },
                    "owner": {
                      "type": "string",
                      "description": "Responsible role."
                    },
                    "status": {
                      "type": "string",
                      "description": "Progression state."
                    }
                  }
                }
              }
            }
          },
          "portfolio": {
            "type": "object",
            "description": "Account portfolio rollup.",
            "properties": {
              "deal_count": {
                "type": "integer",
                "description": "Total deals.",
                "x-unit": "count"
              },
              "active_deal_count": {
                "type": "integer",
                "description": "Active deals.",
                "x-unit": "count"
              },
              "won_deal_count": {
                "type": "integer",
                "description": "Won deals.",
                "x-unit": "count"
              },
              "at_risk_deal_count": {
                "type": "integer",
                "description": "At-risk deals.",
                "x-unit": "count"
              },
              "total_pipeline_value": {
                "type": "number",
                "description": "Sum of portfolio deal values.",
                "x-unit": "currency units"
              },
              "weighted_pipeline_value": {
                "type": "number",
                "description": "Deal values weighted by closing probability.",
                "x-unit": "currency units"
              },
              "top_deal": {
                "type": "object",
                "description": "Largest deal by amount.",
                "properties": {
                  "deal_id": {
                    "type": "string",
                    "description": "Opportunity identifier."
                  },
                  "deal_name": {
                    "type": "string",
                    "description": "Opportunity display name."
                  },
                  "amount": {
                    "type": "number",
                    "description": "Opportunity amount.",
                    "x-unit": "currency units"
                  },
                  "stage": {
                    "type": "string",
                    "description": "Opportunity stage."
                  },
                  "overall_score": {
                    "type": "string",
                    "description": "Qualification label."
                  }
                }
              }
            }
          },
          "readiness": {
            "type": "object",
            "description": "Account readiness assessment.",
            "properties": {
              "meddpicc_health_pct": {
                "type": "number",
                "description": "Normalized average MEDDPICC score.",
                "x-unit": "percent"
              },
              "artifacts": {
                "type": "object",
                "description": "Readiness-artifact checks keyed by artifact name.",
                "additionalProperties": {
                  "type": "object",
                  "description": "Artifact state and supporting basis.",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "Artifact state."
                    },
                    "source_basis": {
                      "type": "string",
                      "description": "Evidence or inference underlying the artifact state."
                    }
                  }
                }
              }
            }
          },
          "enablement": {
            "type": "object",
            "description": "Account-level enablement summary.",
            "properties": {
              "coverage_pct": {
                "type": "number",
                "description": "Average training coverage.",
                "x-unit": "percent"
              },
              "skills_gap_risk_score": {
                "type": "number",
                "description": "Average skills-gap risk score.",
                "x-unit": "score"
              },
              "annual_consumption": {
                "type": "number",
                "description": "Annual account consumption.",
                "x-unit": "currency units"
              },
              "days_to_renewal": {
                "type": "integer",
                "description": "Minimum days to renewal across source records.",
                "x-unit": "days"
              },
              "source_records": {
                "type": "integer",
                "description": "Number of contributing enablement records.",
                "x-unit": "count"
              }
            }
          },
          "revenue": {
            "type": "object",
            "description": "Estimated account revenue indicators.",
            "properties": {
              "estimated_arr": {
                "type": "number",
                "description": "ARR proxy inferred from pipeline value.",
                "x-unit": "currency units"
              },
              "arr_at_risk": {
                "type": "number",
                "description": "ARR proxy multiplied by derived churn risk.",
                "x-unit": "currency units"
              },
              "expansion_signal_value": {
                "type": "number",
                "description": "Value of active deals used as an expansion signal.",
                "x-unit": "currency units"
              },
              "renewal_probability": {
                "type": "number",
                "description": "Estimated renewal probability.",
                "minimum": 0,
                "maximum": 1,
                "x-unit": "ratio"
              },
              "source_basis": {
                "type": "string",
                "description": "Description of the inference used for revenue indicators."
              }
            }
          },
          "flags": {
            "type": "array",
            "description": "Account risk or opportunity flags.",
            "items": {
              "type": "object",
              "description": "Actionable account flag.",
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Flag classification."
                },
                "severity": {
                  "type": "string",
                  "description": "Flag severity."
                },
                "reason": {
                  "type": "string",
                  "description": "Evidence supporting the flag."
                },
                "owner": {
                  "type": "string",
                  "description": "Responsible role."
                },
                "recommended_action": {
                  "type": "string",
                  "description": "Suggested corrective action."
                },
                "source_basis": {
                  "type": "string",
                  "description": "Evidence or inference used to identify this flag."
                }
              }
            }
          },
          "recommended_actions": {
            "type": "array",
            "description": "Recommended account-team actions.",
            "items": {
              "type": "string",
              "description": "Text supplied by the data owner or generated by the workflow."
            }
          },
          "deal_ids": {
            "type": "array",
            "description": "Associated opportunity identifiers.",
            "items": {
              "type": "string",
              "description": "Text supplied by the data owner or generated by the workflow."
            }
          },
          "monthly_health_trend": {
            "type": "array",
            "description": "Time-ordered health observations; the supplied generator models these rather than observing them.",
            "items": {
              "type": "object",
              "description": "Health observation.",
              "properties": {
                "month_label": {
                  "type": "string",
                  "description": "Observation period label."
                },
                "month_index": {
                  "type": "integer",
                  "description": "One-based period index.",
                  "minimum": 1,
                  "x-unit": "count"
                },
                "health_score": {
                  "type": "number",
                  "description": "Health score for the period.",
                  "x-unit": "score"
                },
                "health_status": {
                  "type": "string",
                  "description": "Health category for the period."
                },
                "churn_risk_score": {
                  "type": "number",
                  "description": "Churn risk score for the period.",
                  "x-unit": "score"
                },
                "churn_risk": {
                  "type": "string",
                  "description": "Churn risk category for the period."
                },
                "enablement_coverage_pct": {
                  "type": "number",
                  "description": "Training coverage for the period.",
                  "x-unit": "percent"
                },
                "skills_gap_risk_score": {
                  "type": "number",
                  "description": "Skills-gap risk score for the period.",
                  "x-unit": "score"
                },
                "arr_at_risk": {
                  "type": "number",
                  "description": "Estimated ARR at risk for the period.",
                  "x-unit": "currency units"
                },
                "open_action_count": {
                  "type": "integer",
                  "description": "Outstanding actions.",
                  "x-unit": "count"
                },
                "high_severity_flag_count": {
                  "type": "integer",
                  "description": "High-severity flags.",
                  "x-unit": "count"
                },
                "adoption_impact_pct": {
                  "type": "number",
                  "description": "Modeled adoption impact proxy.",
                  "x-unit": "percent"
                }
              }
            }
          },
          "trend_summary": {
            "type": "object",
            "description": "Derived account trend summary.",
            "properties": {
              "direction": {
                "type": "string",
                "description": "Direction of the health trend."
              },
              "health_delta": {
                "type": "number",
                "description": "Final minus initial health score.",
                "x-unit": "score points"
              },
              "arr_at_risk_delta": {
                "type": "number",
                "description": "Final minus initial ARR at risk.",
                "x-unit": "currency units"
              },
              "coverage_delta": {
                "type": "number",
                "description": "Final minus initial training coverage.",
                "x-unit": "percentage points"
              },
              "latest_month": {
                "type": "string",
                "description": "Latest observation period."
              }
            }
          }
        },
        "required": [
          "customer_slug",
          "account_info",
          "health"
        ]
      }
    }
  },
  "required": [
    "customers"
  ]
}
