{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnablementRecords",
  "type": "array",
  "description": "Enablement input collection supplied by the operator.",
  "items": {
    "type": "object",
    "description": "Per-deal enablement and adoption inputs.",
    "properties": {
      "company_slug": {
        "type": "string",
        "description": "Normalized account key joining notes and account data."
      },
      "deal_slug": {
        "type": "string",
        "description": "Normalized deal key used in note directories."
      },
      "company": {
        "type": "string",
        "description": "Account display name."
      },
      "deal_name": {
        "type": "string",
        "description": "Deal display name."
      },
      "deal_id": {
        "type": "string",
        "description": "Opportunity identifier."
      },
      "deal_amount": {
        "type": "number",
        "description": "Deal amount used for enablement context.",
        "x-unit": "currency units"
      },
      "company_tier": {
        "type": "string",
        "description": "Account tier used by configured defaults."
      },
      "licensed_users": {
        "type": "integer",
        "description": "Number of licensed users.",
        "minimum": 0,
        "x-unit": "count"
      },
      "trained_users": {
        "type": "integer",
        "description": "Number of trained users.",
        "minimum": 0,
        "x-unit": "count"
      },
      "enablement_coverage_pct": {
        "type": "number",
        "description": "Trained users divided by licensed users, multiplied by 100.",
        "minimum": 0,
        "maximum": 100,
        "x-unit": "percent"
      },
      "skills_gap_risk_score": {
        "type": "integer",
        "description": "Skills gap risk score.",
        "minimum": 0,
        "maximum": 100,
        "x-unit": "score"
      },
      "azure_annual_consumption": {
        "type": "number",
        "description": "Annual Azure consumption used by enablement triggers.",
        "x-unit": "currency units"
      },
      "certifications_held": {
        "type": "array",
        "description": "Certifications reported by the operator.",
        "items": {
          "type": "string",
          "description": "Text supplied by the data owner or generated by the workflow."
        }
      },
      "attendance_rate_pct": {
        "type": "number",
        "description": "Training attendance rate.",
        "minimum": 0,
        "maximum": 100,
        "x-unit": "percent"
      },
      "days_inactive": {
        "type": "integer",
        "description": "Days since relevant user activity.",
        "minimum": 0,
        "x-unit": "days"
      },
      "days_to_renewal": {
        "type": "integer",
        "description": "Days until renewal.",
        "minimum": 0,
        "x-unit": "days"
      },
      "partner_managed_status": {
        "type": "boolean",
        "description": "Whether enablement is partner managed."
      },
      "learner_roster": {
        "type": "array",
        "description": "Operator-supplied learner records; no roster is included.",
        "items": {
          "type": "object",
          "description": "Learner record.",
          "properties": {
            "learner_id": {
              "type": "string",
              "description": "Learner identifier."
            },
            "role_persona": {
              "type": "string",
              "description": "Learner role category."
            },
            "courses_completed": {
              "type": "array",
              "description": "Completed course identifiers.",
              "items": {
                "type": "string",
                "description": "Text supplied by the data owner or generated by the workflow."
              }
            },
            "certifications": {
              "type": "array",
              "description": "Held certification identifiers.",
              "items": {
                "type": "string",
                "description": "Text supplied by the data owner or generated by the workflow."
              }
            }
          },
          "required": [
            "learner_id",
            "role_persona",
            "courses_completed",
            "certifications"
          ]
        }
      },
      "enablement_data_version": {
        "type": "string",
        "description": "Version of the enablement input format."
      },
      "scored_at": {
        "type": "string",
        "description": "Normalization or scoring timestamp in ISO 8601 form."
      },
      "trigger_flags": {
        "type": "array",
        "description": "Computed enablement triggers.",
        "items": {
          "type": "object",
          "description": "Enablement trigger.",
          "properties": {
            "code": {
              "type": "string",
              "description": "Trigger code."
            },
            "severity": {
              "type": "string",
              "description": "Trigger severity."
            },
            "reason": {
              "type": "string",
              "description": "Evidence-based trigger reason."
            }
          }
        }
      }
    },
    "required": [
      "company_slug",
      "deal_slug",
      "licensed_users",
      "trained_users",
      "enablement_coverage_pct",
      "skills_gap_risk_score",
      "azure_annual_consumption",
      "learner_roster"
    ]
  }
}
