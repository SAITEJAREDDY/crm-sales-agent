{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConsumptionProfile",
  "type": "object",
  "description": "Workload requirements used for architecture planning.",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Identifier joining this profile to a canonical deal."
    },
    "workload_type": {
      "type": "string",
      "description": "Workload classification."
    },
    "expected_users": {
      "type": "integer",
      "description": "Expected total users.",
      "minimum": 0,
      "x-unit": "users"
    },
    "concurrent_users": {
      "type": "integer",
      "description": "Expected concurrently active users.",
      "minimum": 0,
      "x-unit": "users"
    },
    "monthly_transactions": {
      "type": "number",
      "description": "Expected transactions per month.",
      "minimum": 0,
      "x-unit": "transactions/month"
    },
    "requests_per_second": {
      "type": "number",
      "description": "Expected request throughput.",
      "minimum": 0,
      "x-unit": "requests/second"
    },
    "data_volume_tb": {
      "type": "number",
      "description": "Initial stored data volume.",
      "minimum": 0,
      "x-unit": "TB"
    },
    "monthly_data_growth_tb": {
      "type": "number",
      "description": "Expected monthly data growth.",
      "minimum": 0,
      "x-unit": "TB/month"
    },
    "retention_months": {
      "type": "integer",
      "description": "Required data retention.",
      "minimum": 0,
      "x-unit": "months"
    },
    "backup_required": {
      "type": "boolean",
      "description": "Whether backup is required."
    },
    "availability_target": {
      "type": "string",
      "description": "Availability objective supplied by the operator."
    },
    "dr_required": {
      "type": "boolean",
      "description": "Whether disaster recovery is required."
    },
    "environment_count": {
      "type": "integer",
      "description": "Number of application environments.",
      "minimum": 1,
      "x-unit": "count"
    },
    "environments": {
      "type": "array",
      "description": "Environment names.",
      "items": {
        "type": "string",
        "description": "Text supplied by the data owner or generated by the workflow."
      }
    },
    "primary_region": {
      "type": "string",
      "description": "Primary cloud region."
    },
    "secondary_region": {
      "type": [
        "string",
        "null"
      ],
      "description": "Secondary cloud region; null when none is required."
    },
    "year_2_growth_rate": {
      "type": "number",
      "description": "Second-year growth as a fraction, not a percentage.",
      "x-unit": "ratio"
    },
    "year_3_growth_rate": {
      "type": "number",
      "description": "Third-year growth as a fraction, not a percentage.",
      "x-unit": "ratio"
    },
    "profile_source": {
      "type": "string",
      "description": "Source of the workload profile."
    },
    "confidence": {
      "type": "string",
      "description": "Confidence assessment of the supplied requirements."
    },
    "notes": {
      "type": "string",
      "description": "Operator-supplied workload notes."
    }
  },
  "required": [
    "deal_id",
    "workload_type"
  ]
}
