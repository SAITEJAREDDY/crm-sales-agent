{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConsumptionArchitecture",
  "type": "object",
  "description": "Architecture proposal without resolved prices.",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Identifier of the associated deal."
    },
    "architecture_version": {
      "type": "string",
      "description": "Architecture format version."
    },
    "architecture_mode": {
      "type": "string",
      "description": "Planning objective.",
      "enum": [
        "EXPECTED",
        "COMMITMENT_ALIGNED"
      ]
    },
    "summary": {
      "type": "string",
      "description": "Explanation of the proposed architecture."
    },
    "assumptions": {
      "type": "array",
      "description": "Planning assumptions that require operator review.",
      "items": {
        "type": "string",
        "description": "Text supplied by the data owner or generated by the workflow."
      }
    },
    "services": {
      "type": "array",
      "description": "Service rows; prices and financial outputs are excluded from this contract.",
      "items": {
        "type": "object",
        "description": "Azure architecture bill-of-materials line; pricing is resolved separately.",
        "properties": {
          "service_id": {
            "type": "string",
            "description": "Unique service-row identifier within the architecture."
          },
          "catalog_id": {
            "type": "string",
            "description": "Optional reference to an operator-supplied supported catalog entry."
          },
          "service_category": {
            "type": "string",
            "description": "Service category accepted by the architecture validator."
          },
          "azure_service": {
            "type": "string",
            "description": "Canonical Azure service name."
          },
          "sku": {
            "type": "string",
            "description": "Requested SKU."
          },
          "arm_sku_name": {
            "type": "string",
            "description": "Azure Resource Manager SKU identifier, when known."
          },
          "tier": {
            "type": "string",
            "description": "Requested service tier."
          },
          "region": {
            "type": "string",
            "description": "Deployment region used for pricing resolution."
          },
          "environment": {
            "type": "string",
            "description": "Environment served by the row."
          },
          "quantity": {
            "type": "number",
            "description": "Number of deployed units.",
            "exclusiveMinimum": 0,
            "x-unit": "units"
          },
          "usage_type": {
            "type": "string",
            "description": "Type of metered usage."
          },
          "monthly_usage_per_unit": {
            "type": "number",
            "description": "Usage per deployed unit during a month.",
            "minimum": 0,
            "x-unit": "usage units/month/unit"
          },
          "unit": {
            "type": "string",
            "description": "Meter unit associated with monthly_usage_per_unit."
          },
          "dr_replication": {
            "type": "boolean",
            "description": "Whether the row participates in disaster-recovery replication."
          },
          "rationale": {
            "type": "string",
            "description": "Reason this service and sizing were selected."
          },
          "confidence": {
            "type": "string",
            "description": "Confidence band for this service choice.",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          }
        },
        "required": [
          "service_id",
          "service_category",
          "azure_service",
          "region",
          "quantity",
          "usage_type",
          "monthly_usage_per_unit",
          "unit",
          "confidence"
        ]
      },
      "minItems": 1
    },
    "completeness": {
      "type": "object",
      "description": "Computed workload-domain coverage.",
      "properties": {
        "coverage_percent": {
          "type": "number",
          "description": "Share of required domains covered.",
          "x-unit": "percent"
        },
        "covered_domains": {
          "type": "integer",
          "description": "Number of covered domains.",
          "x-unit": "count"
        },
        "required_domains": {
          "type": "integer",
          "description": "Number of required domains.",
          "x-unit": "count"
        },
        "missing_domains": {
          "type": "array",
          "description": "Required workload domains absent from the architecture.",
          "items": {
            "type": "string",
            "description": "Text supplied by the data owner or generated by the workflow."
          }
        }
      }
    }
  },
  "required": [
    "deal_id",
    "summary",
    "services"
  ]
}
