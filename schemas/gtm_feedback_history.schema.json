{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GTMFeedbackHistory",
  "type": "object",
  "description": "Account observation and intervention history supplied by the operator.",
  "properties": {
    "generated_at": {
      "type": "string",
      "description": "History generation timestamp."
    },
    "data_version": {
      "type": "string",
      "description": "History format version."
    },
    "source_files": {
      "type": "array",
      "description": "Paths or references of the operator-owned inputs.",
      "items": {
        "type": "string",
        "description": "Text supplied by the data owner or generated by the workflow."
      }
    },
    "design_note": {
      "type": "string",
      "description": "History construction method and limitations."
    },
    "historical_period": {
      "type": "object",
      "description": "Time range covered by observations.",
      "properties": {
        "start": {
          "type": "string",
          "description": "First period."
        },
        "end": {
          "type": "string",
          "description": "Last period."
        },
        "latest_month": {
          "type": "string",
          "description": "Latest observation period."
        }
      }
    },
    "accounts": {
      "type": "array",
      "description": "Accounts with observation histories; no account records are included.",
      "items": {
        "type": "object",
        "description": "Account history.",
        "properties": {
          "account_slug": {
            "type": "string",
            "description": "Stable key for account history joins."
          },
          "account_name": {
            "type": "string",
            "description": "Account display name."
          },
          "primary_rep": {
            "type": "string",
            "description": "Primary representative supplied by the operator."
          },
          "primary_product": {
            "type": "string",
            "description": "Primary product classification."
          },
          "deal_id": {
            "type": "string",
            "description": "Associated opportunity identifier."
          },
          "deal_name": {
            "type": "string",
            "description": "Associated opportunity display name."
          },
          "segment": {
            "type": "string",
            "description": "Latest account segment."
          },
          "journey_type": {
            "type": "string",
            "description": "Classification of the account trajectory."
          },
          "monthly_observations": {
            "type": "array",
            "description": "Time-ordered account observations.",
            "items": {
              "type": "object",
              "description": "One account observation period.",
              "properties": {
                "month": {
                  "type": "string",
                  "description": "Observation period identifier."
                },
                "month_label": {
                  "type": "string",
                  "description": "Display label for the observation period."
                },
                "segment": {
                  "type": "string",
                  "description": "Account attention or health segment for the period."
                },
                "licensed_users": {
                  "type": "integer",
                  "description": "Licensed users in the period.",
                  "x-unit": "users"
                },
                "trained_users": {
                  "type": "integer",
                  "description": "Trained users in the period.",
                  "x-unit": "users"
                },
                "active_users": {
                  "type": "integer",
                  "description": "Active users in the period.",
                  "x-unit": "users"
                },
                "training_completions": {
                  "type": "integer",
                  "description": "Training completions during the period.",
                  "x-unit": "count"
                },
                "workshop_attendance": {
                  "type": "integer",
                  "description": "Workshop attendees during the period.",
                  "x-unit": "count"
                },
                "enablement_coverage_pct": {
                  "type": "number",
                  "description": "Training coverage in the period.",
                  "x-unit": "percent"
                },
                "active_user_rate_pct": {
                  "type": "number",
                  "description": "Active users divided by licensed users, multiplied by 100.",
                  "x-unit": "percent"
                },
                "cloud_platform_consumption": {
                  "type": "number",
                  "description": "Cloud consumption during the observation period.",
                  "x-unit": "currency units"
                },
                "account_health_score": {
                  "type": "number",
                  "description": "Account health score in the period.",
                  "x-unit": "score"
                },
                "account_health_status": {
                  "type": "string",
                  "description": "Health category in the period."
                },
                "churn_risk_score": {
                  "type": "number",
                  "description": "Estimated churn risk score in the period.",
                  "x-unit": "score"
                },
                "churn_risk": {
                  "type": "string",
                  "description": "Churn risk category."
                },
                "support_escalation_count": {
                  "type": "integer",
                  "description": "Support escalations during the period.",
                  "x-unit": "count"
                },
                "days_to_renewal": {
                  "type": "integer",
                  "description": "Days to renewal at the observation date.",
                  "x-unit": "days"
                },
                "pipeline_value": {
                  "type": "number",
                  "description": "Pipeline value during the period.",
                  "x-unit": "currency units"
                },
                "arr_or_commercial_value": {
                  "type": "number",
                  "description": "Commercial value or ARR proxy; identify the actual basis in the source data.",
                  "x-unit": "currency units"
                },
                "opportunity_stage": {
                  "type": "string",
                  "description": "Opportunity stage during the period."
                },
                "observation": {
                  "type": "string",
                  "description": "Operator-supplied context for the measurements."
                }
              }
            }
          },
          "journey_summary": {
            "type": "object",
            "description": "Derived changes between the first and last observation periods.",
            "properties": {
              "january_segment": {
                "type": "string",
                "description": "Initial-period segment under the current history generator."
              },
              "july_segment": {
                "type": "string",
                "description": "Final-period segment under the current history generator."
              },
              "health_delta": {
                "type": "number",
                "description": "Change in health score.",
                "x-unit": "score points"
              },
              "coverage_delta": {
                "type": "number",
                "description": "Change in training coverage.",
                "x-unit": "percentage points"
              },
              "active_user_delta": {
                "type": "integer",
                "description": "Change in active users.",
                "x-unit": "users"
              },
              "consumption_delta": {
                "type": "number",
                "description": "Change in consumption.",
                "x-unit": "currency units"
              },
              "outcome": {
                "type": "string",
                "description": "Interpretation of the trajectory; does not establish causation."
              }
            }
          },
          "recommendation_ids": {
            "type": "array",
            "description": "References to recommendation events.",
            "items": {
              "type": "string",
              "description": "Text supplied by the data owner or generated by the workflow."
            }
          }
        },
        "required": [
          "account_slug",
          "account_name",
          "monthly_observations"
        ]
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Historical recommendations and recorded outcomes.",
      "items": {
        "type": "object",
        "description": "Recommendation event.",
        "properties": {
          "recommendation_id": {
            "type": "string",
            "description": "Unique recommendation identifier."
          },
          "account_slug": {
            "type": "string",
            "description": "Account join key."
          },
          "deal_id": {
            "type": "string",
            "description": "Opportunity join key."
          },
          "account": {
            "type": "string",
            "description": "Account display name."
          },
          "deal_name": {
            "type": "string",
            "description": "Associated deal display name."
          },
          "generated_by": {
            "type": "string",
            "description": "Workflow that produced the recommendation."
          },
          "owner": {
            "type": "string",
            "description": "Responsible representative supplied by the operator."
          },
          "date": {
            "type": "string",
            "description": "Recommendation date."
          },
          "trigger": {
            "type": "string",
            "description": "Signal that prompted the recommendation."
          },
          "recommended_action": {
            "type": "string",
            "description": "Recommended action."
          },
          "target_persona": {
            "type": "string",
            "description": "Role targeted by the recommendation."
          },
          "reason": {
            "type": "string",
            "description": "Evidence supporting the recommendation."
          },
          "confidence": {
            "type": "number",
            "description": "Recommendation confidence.",
            "minimum": 0,
            "maximum": 1,
            "x-unit": "ratio"
          },
          "seller_response": {
            "type": "string",
            "description": "Recorded response from the account team."
          },
          "execution_status": {
            "type": "string",
            "description": "Recorded execution state."
          },
          "seller_response_reason": {
            "type": "string",
            "description": "Reason for the recorded response."
          },
          "outcome": {
            "type": "string",
            "description": "Recorded subsequent observation; does not prove causation."
          },
          "subsequent_observation_month": {
            "type": "string",
            "description": "Observation period used to assess subsequent changes."
          }
        }
      }
    }
  },
  "required": [
    "accounts",
    "recommendations"
  ]
}
