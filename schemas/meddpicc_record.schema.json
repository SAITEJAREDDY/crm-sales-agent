{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MEDDPICCRecord",
  "type": "object",
  "description": "Per-opportunity sales qualification assessment.",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "CRM opportunity identifier."
    },
    "deal_name": {
      "type": "string",
      "description": "Deal display name."
    },
    "company": {
      "type": "string",
      "description": "Account display name."
    },
    "stage": {
      "type": "string",
      "description": "CRM opportunity stage."
    },
    "amount": {
      "type": "number",
      "description": "Opportunity amount.",
      "x-unit": "currency units"
    },
    "probability": {
      "type": "number",
      "description": "Closing probability.",
      "minimum": 0,
      "maximum": 100,
      "x-unit": "percent"
    },
    "assigned_rep": {
      "type": "string",
      "description": "Representative supplied by the operator."
    },
    "overall_score": {
      "type": "string",
      "description": "Overall qualification label; interpreted by the scoring code."
    },
    "overall_reason": {
      "type": "string",
      "description": "Reason for the qualification label."
    },
    "next_priority": {
      "type": "string",
      "description": "Next qualification action."
    },
    "scored_at": {
      "type": "string",
      "description": "Scoring timestamp in ISO 8601 form."
    },
    "elements": {
      "type": "object",
      "description": "The eight qualification dimensions.",
      "properties": {
        "metrics": {
          "type": "object",
          "description": "Evidence assessment for one MEDDPICC qualification dimension.",
          "properties": {
            "status": {
              "type": "string",
              "description": "Qualification state.",
              "enum": [
                "confirmed",
                "partial",
                "at_risk",
                "unknown"
              ]
            },
            "evidence": {
              "type": "string",
              "description": "Evidence supporting this qualification state."
            },
            "source_note": {
              "type": "string",
              "description": "Reference to the supporting note supplied at runtime."
            },
            "gap": {
              "type": "string",
              "description": "Missing qualification evidence or an unresolved question."
            }
          }
        },
        "economic_buyer": {
          "type": "object",
          "description": "Evidence assessment for one MEDDPICC qualification dimension.",
          "properties": {
            "status": {
              "type": "string",
              "description": "Qualification state.",
              "enum": [
                "confirmed",
                "partial",
                "at_risk",
                "unknown"
              ]
            },
            "evidence": {
              "type": "string",
              "description": "Evidence supporting this qualification state."
            },
