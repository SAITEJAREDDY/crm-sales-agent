              "description": "Qualification state.",
              "enum": [
                "confirmed",
                "partial",
                "at_risk",
                "unknown"
              ]
            },
            "evidence": {
              "type": "string",
              "description": "Evidence supporting this qualification state."
            },
            "source_note": {
              "type": "string",
              "description": "Reference to the supporting note supplied at runtime."
            },
            "gap": {
              "type": "string",
              "description": "Missing qualification evidence or an unresolved question."
            }
          }
        }
      }
    },
    "flags": {
      "type": "object",
      "description": "Computed qualification risks.",
      "properties": {
        "missing_economic_buyer": {
          "type": "boolean",
          "description": "Whether this qualification risk is present."
        },
        "missing_champion": {
          "type": "boolean",
          "description": "Whether this qualification risk is present."
        },
        "unquantified_pain": {
          "type": "boolean",
          "description": "Whether this qualification risk is present."
        },
        "competitor_unknown": {
          "type": "boolean",
          "description": "Whether this qualification risk is present."
        },
        "paper_process_unknown": {
          "type": "boolean",
          "description": "Whether this qualification risk is present."
        },
        "deal_overdue": {
          "type": "boolean",
          "description": "Whether this qualification risk is present."
        },
        "stalled": {
          "type": "boolean",
          "description": "Whether this qualification risk is present."
        }
      }
    },
    "notes_analysed": {
      "type": "array",
      "description": "Identifiers of source notes used in the assessment.",
      "items": {
        "type": "string",
        "description": "Text supplied by the data owner or generated by the workflow."
      }
    }
  },
  "required": [
    "deal_id",
    "deal_name",
    "company",
    "elements",
    "flags"
  ]
}
