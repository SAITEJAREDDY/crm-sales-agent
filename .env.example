# Copy this file to .env and fill in your credentials.
# .env stays local; commit only this example with empty secret values.

# Twenty CRM (required for CRM access)
TWENTY_API_TOKEN=

# Qwen on Together AI (shared by all text-generation workflows)
TOGETHER_API_KEY=
TOGETHER_MODEL=Qwen/Qwen3.8-Flash
TOGETHER_REASONING_EFFORT=low

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=deal-desk-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional email delivery
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# Optional provider identity for generated agreement drafts
COMMERCIAL_PROVIDER_NAME=
