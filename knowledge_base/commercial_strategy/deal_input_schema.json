{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DealInput",
  "type": "object",
  "description": "Canonical account, opportunity, and commercial inputs.",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Stable identifier joining the workflow inputs and outputs."
    },
    "opportunity_id": {
      "type": "string",
      "description": "Identifier of the source CRM opportunity."
    },
    "quote_id": {
      "type": "string",
      "description": "Identifier of the associated quote, if supplied."
    },
    "provenance": {
      "type": "object",
      "description": "Provenance and mapping notes.",
      "properties": {}
    },
    "account": {
      "type": "object",
      "description": "Account context joined to an opportunity.",
      "properties": {
        "account_id": {
          "type": "string",
          "description": "Stable account identifier used for joins."
        },
        "name": {
          "type": "string",
          "description": "Account display name supplied by the operator."
        },
        "industry": {
          "type": "string",
          "description": "Industry classification used for comparable selection."
        },
        "region": {
          "type": "string",
          "description": "Account geography; distinct from a cloud deployment region."
        },
        "segment": {
          "type": "string",
          "description": "Commercial account segment."
        },
        "strategic_account": {
          "type": "boolean",
          "description": "Whether the account has strategic significance."
        },
        "existing_customer": {
          "type": "boolean",
          "description": "Whether the account already has a customer relationship."
        },
        "customer_tenure_years": {
          "type": "number",
          "description": "Length of the existing relationship.",
          "minimum": 0,
          "x-unit": "years"
        },
        "existing_product_footprint": {
          "type": "array",
          "description": "Products already adopted by this account.",
          "items": {
            "type": "string",
            "description": "Text supplied by the data owner or generated by the workflow."
          }
        },
        "existing_annual_spend": {
          "type": "number",
          "description": "Existing annual account spend.",
          "x-unit": "currency units"
        }
      },
      "required": [
        "account_id",
        "name"
      ]
    },
    "opportunity": {
      "type": "object",
      "description": "CRM opportunity context.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Opportunity display name."
        },
        "stage": {
          "type": "string",
          "description": "CRM opportunity stage; map tenant-specific stages before ingestion."
        },
        "probability": {
          "type": "number",
          "description": "CRM probability of closing.",
          "minimum": 0,
          "maximum": 100,
          "x-unit": "percent"
        },
        "expected_close_date": {
          "type": "string",
          "description": "Expected close date in ISO calendar-date form."
        },
        "currency": {
          "type": "string",
          "description": "Currency code for opportunity monetary fields."
        },
        "assigned_rep": {
          "type": "string",
          "description": "Representative identifier or display name supplied by the operator."
        },
        "meddpicc_score": {
          "type": "string",
          "description": "Qualification label produced by the MEDDPICC workflow."
        }
      }
    },
    "commercial": {
      "type": "object",
      "description": "Pricing and contract inputs used by deterministic calculations.",
      "properties": {
        "contract_term_months": {
          "type": "integer",
          "description": "Contract duration.",
          "minimum": 1,
          "x-unit": "months"
        },
        "list_value": {
          "type": "number",
          "description": "Undiscounted contract value over the full term.",
          "x-unit": "currency units"
        },
        "requested_discount_pct": {
          "type": "number",
          "description": "Customer-requested discount.",
          "minimum": 0,
          "maximum": 100,
          "x-unit": "percent"
        },
        "proposed_discount_pct": {
          "type": "number",
          "description": "Working seller discount.",
          "minimum": 0,
          "maximum": 100,
          "x-unit": "percent"
        },
        "proposed_net_value": {
          "type": "number",
          "description": "Full-term net contract value: list_value multiplied by one minus proposed_discount_pct / 100; equals TCV.",
          "x-unit": "currency units"
        },
        "billing_frequency": {
          "type": "string",
          "description": "Billing cadence interpreted by the financial engine."
        },
        "payment_terms": {
          "type": "string",
          "description": "Payment terms interpreted to obtain the payment delay."
        },
        "renewal_type": {
          "type": "string",
          "description": "Classification of the purchase or renewal motion."
        },
        "arr": {
          "type": "number",
          "description": "Annual recurring revenue at the proposed structure.",
          "x-unit": "currency units"
        },
        "acv": {
          "type": "number",
          "description": "Annual contract value.",
          "x-unit": "currency units"
        },
        "tcv": {
          "type": "number",
          "description": "Total contract value across the full contract term.",
          "x-unit": "currency units"
        },
        "currency": {
          "type": "string",
          "description": "Currency code shared by the monetary inputs."
        }
      },
      "required": [
        "contract_term_months",
        "requested_discount_pct",
        "proposed_discount_pct",
        "currency"
      ]
    },
    "products": {
      "type": "array",
      "description": "Product or SKU lines in the deal.",
      "items": {
        "type": "object",
        "description": "A product or SKU line supplied by the operator.",
        "properties": {
          "product": {
            "type": "string",
            "description": "Product name used by product matching and comparable retrieval."
          },
          "sku": {
            "type": "string",
            "description": "Product SKU identifier."
          },
          "category": {
            "type": "string",
            "description": "Product category used by mapping rules."
          },
          "quantity": {
            "type": "number",
            "description": "Quantity of the product line.",
            "minimum": 0,
            "x-unit": "units"
          },
          "unit_price": {
            "type": "number",
            "description": "Price per product unit for the declared pricing period.",
            "x-unit": "currency units"
          },
          "list_value": {
            "type": "number",
            "description": "Undiscounted value of this product line.",
            "x-unit": "currency units"
          }
        }
      },
      "minItems": 1
    },
    "consumption_commitment": {
      "type": "object",
      "description": "Customer consumption commitment and expected consumption.",
      "properties": {
        "commitment_type": {
          "type": "string",
          "description": "Classification of the commitment agreement."
        },
        "commitment_amount": {
          "type": "number",
          "description": "Total committed consumption spend over the commitment period.",
          "x-unit": "currency units"
        },
        "commitment_period_months": {
          "type": "integer",
          "description": "Commitment duration.",
          "minimum": 1,
          "x-unit": "months"
        },
        "start_date": {
          "type": "string",
          "description": "Commitment start date in ISO calendar-date form."
        },
        "end_date": {
          "type": "string",
          "description": "Commitment end date in ISO calendar-date form."
        },
        "year_1_target": {
          "type": "number",
          "description": "Consumption target for the first year.",
          "x-unit": "currency units"
        },
        "year_2_target": {
          "type": "number",
          "description": "Consumption target for the second year.",
          "x-unit": "currency units"
        },
        "year_3_target": {
          "type": "number",
          "description": "Consumption target for the third year.",
          "x-unit": "currency units"
        },
        "eligible_spend_categories": {
          "type": "array",
          "description": "Spend categories eligible to satisfy the commitment.",
          "items": {
            "type": "string",
            "description": "Text supplied by the data owner or generated by the workflow."
          }
        },
        "current_expected_consumption": {
          "type": "number",
          "description": "Expected first-year deal-level consumption; the engine applies growth for subsequent years.",
          "x-unit": "currency units"
        }
      }
    },
    "competitive_context": {
      "type": "object",
      "description": "Competitive conditions used by the strategy agent.",
      "properties": {
        "primary_competitor": {
          "type": "string",
          "description": "Primary competitor identified by the account team."
        },
        "competitive_deal": {
          "type": "boolean",
          "description": "Whether this is a competitive opportunity."
        },
        "competitor_offer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Operator-supplied description of the competing offer; null if unavailable."
        },
        "customer_switching_risk": {
          "type": "string",
          "description": "Assessment of the customer's switching risk."
        },
        "customer_price_sensitivity": {
          "type": "string",
          "description": "Assessment of price sensitivity."
        }
      }
    },
    "customer_asks": {
      "type": "array",
      "description": "Customer-requested changes supplied by the account team.",
      "items": {
        "type": "string",
        "description": "Text supplied by the data owner or generated by the workflow."
      }
    },
    "negotiation_context": {
      "type": "object",
      "description": "Requested and proposed terms and negotiation notes.",
      "properties": {
        "customer_requested_commercial_terms": {
          "type": "object",
          "description": "Customer-requested contract terms.",
          "properties": {}
        },
        "sales_proposed_commercial_terms": {
          "type": "object",
          "description": "Seller-proposed contract terms.",
          "properties": {}
        },
        "potential_concessions": {
          "type": "array",
          "description": "Potential concessions requiring deterministic validation.",
          "items": {
            "type": "string",
            "description": "Text supplied by the data owner or generated by the workflow."
          }
        },
        "deal_blockers": {
          "type": "array",
          "description": "Open conditions preventing agreement.",
          "items": {
            "type": "string",
            "description": "Text supplied by the data owner or generated by the workflow."
          }
        },
        "negotiation_notes": {
          "type": "array",
          "description": "Negotiation observations supplied by the operator.",
          "items": {
            "type": "object",
            "description": "A negotiation note and its author role.",
            "properties": {
              "author_role": {
                "type": "string",
                "description": "Role that supplied the note."
              },
              "note": {
                "type": "string",
                "description": "Negotiation observation."
              }
            },
            "required": [
              "author_role",
              "note"
            ]
          }
        }
      }
    },
    "strategic_context": {
      "type": "object",
      "description": "Qualitative strategic context.",
      "properties": {
        "expansion_potential": {
          "type": "string",
          "description": "Assessment of future expansion opportunity."
        },
        "reference_customer_potential": {
          "type": "boolean",
          "description": "Whether reference participation is possible."
        },
        "executive_sponsorship": {
          "type": "boolean",
          "description": "Whether executive sponsorship is established."
        },
        "customer_priorities": {
          "type": "array",
          "description": "Ranked customer priorities.",
          "items": {
            "type": "object",
            "description": "Ranked negotiation priority.",
            "properties": {
              "rank": {
                "type": "integer",
                "description": "Priority order, with one denoting the highest priority.",
                "minimum": 1,
                "x-unit": "count"
              },
              "priority": {
                "type": "string",
                "description": "Priority classification."
              },
              "rationale": {
                "type": "string",
                "description": "Reason for this priority."
              }
            },
            "required": [
              "rank",
              "priority",
              "rationale"
            ]
          }
        },
        "seller_priorities": {
          "type": "array",
          "description": "Ranked seller priorities.",
          "items": {
            "type": "object",
            "description": "Ranked negotiation priority.",
            "properties": {
              "rank": {
                "type": "integer",
                "description": "Priority order, with one denoting the highest priority.",
                "minimum": 1,
                "x-unit": "count"
              },
              "priority": {
                "type": "string",
                "description": "Priority classification."
              },
              "rationale": {
                "type": "string",
                "description": "Reason for this priority."
              }
            },
            "required": [
              "rank",
              "priority",
              "rationale"
            ]
          }
        }
      }
    },
    "approval_context": {
      "type": "object",
      "description": "Approval context supplied at runtime.",
      "properties": {
        "required_approvals": {
          "type": "array",
          "description": "Review requirements supplied with the input, before policy re-evaluation.",
          "items": {
            "type": "object",
            "description": "Input approval requirement.",
            "properties": {
              "issue_type": {
                "type": "string",
                "description": "Commercial issue that requires review."
              },
              "primary_review_function": {
                "type": "string",
                "description": "Function responsible for the initial review."
              },
              "severity": {
                "type": "string",
                "description": "Severity of the issue."
              },
              "status": {
                "type": "string",
                "description": "Recorded submission status."
              },
              "reason": {
                "type": "string",
                "description": "Reason the input mapper requested review."
              }
            }
          }
        },
        "applicable_guardrail_ids": {
          "type": "array",
          "description": "Identifiers of applicable configured guardrails.",
          "items": {
            "type": "string",
            "description": "Text supplied by the data owner or generated by the workflow."
          }
        },
        "prior_approval_activity": {
          "type": "array",
          "description": "Prior approval events supplied by the operator.",
          "items": {
            "type": "object",
            "description": "Approval event.",
            "properties": {}
          }
        }
      }
    },
    "financial_model_inputs": {
      "type": "object",
      "description": "Inputs mapped to the legacy financial-model runner.",
      "properties": {
        "source": {
          "type": "string",
          "description": "Input source identifier."
        },
        "deal_amount": {
          "type": "number",
          "description": "Amount used by the financial model.",
          "x-unit": "currency units"
        },
        "deal_name": {
          "type": "string",
          "description": "Deal display name."
        },
        "company": {
          "type": "string",
          "description": "Account display name."
        },
        "product": {
          "type": "string",
          "description": "Product display name."
        }
      }
    }
  },
  "required": [
    "deal_id",
    "opportunity_id",
    "account",
    "opportunity",
    "commercial",
    "products",
    "consumption_commitment",
    "competitive_context",
    "customer_asks",
    "strategic_context"
  ]
}
