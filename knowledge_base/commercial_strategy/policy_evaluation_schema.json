{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicyEvaluation",
  "type": "object",
  "description": "Deterministic policy and approval evaluation.",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Identifier of the evaluated deal."
    },
    "scenario": {
      "type": "string",
      "description": "Name of the evaluated scenario."
    },
    "overall_status": {
      "type": "string",
      "description": "Overall policy disposition.",
      "enum": [
        "WITHIN_POLICY",
        "REQUIRES_REVIEW",
        "REQUIRES_APPROVAL",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "object",
      "description": "Aggregated counts and policy assessment.",
      "properties": {}
    },
    "policy_checks": {
      "type": "array",
      "description": "Individual rule outcomes.",
      "items": {
        "type": "object",
        "description": "Result of one configured policy check.",
        "properties": {
          "rule_id": {
            "type": "string",
            "description": "Identifier of the configured rule."
          },
          "policy_id": {
            "type": "string",
            "description": "Identifier of its policy group."
          },
          "category": {
            "type": "string",
            "description": "Policy category."
          },
          "status": {
            "type": "string",
            "description": "Policy-check outcome.",
            "enum": [
              "PASS",
              "REVIEW",
              "EXCEPTION",
              "BLOCK",
              "NOT_APPLICABLE",
              "NOT_MODELED"
            ]
          },
          "severity": {
            "type": "string",
            "description": "Severity assigned by the rule."
          },
          "message": {
            "type": "string",
            "description": "Explanation of the check outcome."
          },
          "actual_value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ],
            "description": "Evaluated value in the declared unit."
          },
          "threshold": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ],
            "description": "Configured comparison boundary."
          },
          "upper_bound": {
            "type": [
              "number",
              "null"
            ],
            "description": "Upper boundary for range checks, when applicable."
          },
          "unit": {
            "type": "string",
            "description": "Unit used by the value and threshold."
          },
          "remediation": {
            "type": [
              "string",
              "null"
            ],
            "description": "Suggested remediation, when applicable."
          },
          "source_configuration": {
            "type": "string",
            "description": "Reference to the rule configuration used."
          }
        }
      }
    },
    "required_approvals": {
      "type": "array",
      "description": "Required approval functions and triggering rules.",
      "items": {
        "type": "object",
        "description": "Required policy approval function, distinct from a completed approval.",
        "properties": {
          "function": {
            "type": "string",
            "description": "Organizational function that must review the proposal."
          },
          "level": {
            "type": "string",
            "description": "Approval authority level."
          },
          "priority": {
            "type": "integer",
            "description": "Routing priority; lower values come first.",
            "x-unit": "count"
          },
          "required": {
            "type": "boolean",
            "description": "Whether this review is required."
          },
          "reasons": {
            "type": "array",
            "description": "Triggered reasons for the review.",
            "items": {
              "type": "string",
              "description": "Text supplied by the data owner or generated by the workflow."
            }
          },
          "source_rules": {
            "type": "array",
            "description": "Rule identifiers that require this approval.",
            "items": {
              "type": "string",
              "description": "Text supplied by the data owner or generated by the workflow."
            }
          }
        }
      }
    },
    "approval_sequence": {
      "type": "array",
      "description": "Ordered approval routing steps.",
      "items": {
        "type": "object",
        "description": "Approval routing step.",
        "properties": {
          "step": {
            "type": "integer",
            "description": "One-based routing step.",
            "minimum": 1,
            "x-unit": "count"
          },
          "function": {
            "type": "string",
            "description": "Organizational function that must review the proposal."
          },
          "level": {
            "type": "string",
            "description": "Approval authority level."
          },
          "priority": {
            "type": "integer",
            "description": "Routing priority; lower values come first.",
            "x-unit": "count"
          },
          "required": {
            "type": "boolean",
            "description": "Whether this review is required."
          },
          "reasons": {
            "type": "array",
            "description": "Triggered reasons for the review.",
            "items": {
              "type": "string",
              "description": "Text supplied by the data owner or generated by the workflow."
            }
          },
          "source_rules": {
            "type": "array",
            "description": "Rule identifiers that require this approval.",
            "items": {
              "type": "string",
              "description": "Text supplied by the data owner or generated by the workflow."
            }
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "description": "Policy exceptions and review conditions.",
      "items": {
        "type": "object",
        "description": "Policy exception.",
        "properties": {}
      }
    },
    "financial_flags": {
      "type": "array",
      "description": "Financial limitations carried into policy evaluation.",
      "items": {
        "type": "string",
        "description": "Text supplied by the data owner or generated by the workflow."
      }
    },
    "trace": {
      "type": "object",
      "description": "Rule configuration references and evaluation trace.",
      "properties": {}
    }
  },
  "required": [
    "deal_id",
    "scenario",
    "overall_status",
    "policy_checks",
    "required_approvals",
    "exceptions"
  ]
}
