{
  "metadata": {
    "name": "Synthetic Enterprise Commercial Policy Rules",
    "provenance": "synthetic_demo_data",
    "disclaimer": "Synthetic enterprise commercial policies for demonstration purposes. Not Microsoft internal commercial rules, approval thresholds, or historical policy.",
    "status_values": ["PASS", "REVIEW", "EXCEPTION", "BLOCK", "NOT_APPLICABLE", "NOT_MODELED"],
    "overall_status_values": ["WITHIN_POLICY", "REQUIRES_REVIEW", "REQUIRES_APPROVAL", "BLOCKED"]
  },
  "rules": [
    {
      "rule_id": "DISC_AE_STANDARD",
      "policy_id": "DISCOUNT_THRESHOLD",
      "category": "Pricing",
      "input_field": "discount_pct",
      "operator": "<=",
      "threshold": 15,
      "unit": "percent",
      "status": "PASS",
      "severity": "LOW",
      "message_template": "Discount is {actual_value}%, within standard AE authority of {threshold}%."
    },
    {
      "rule_id": "DISC_GT_15",
      "policy_id": "DISCOUNT_THRESHOLD",
      "category": "Pricing",
      "input_field": "discount_pct",
      "operator": ">",
      "threshold": 15,
      "upper_bound": 20,
      "unit": "percent",
      "status": "REVIEW",
      "severity": "MEDIUM",
      "exception_type": "PRICING_EXCEPTION",
      "approver_function": "Sales",
      "approver_level": "Sales Manager",
      "approval_priority": 10,
      "documentation_required": true,
      "message_template": "Discount is {actual_value}%, above AE authority and within Sales Manager review band.",
      "remediation": {"action": "Reduce discount to 15% or below", "target_value": 15}
    },
    {
      "rule_id": "DISC_GT_20",
      "policy_id": "DISCOUNT_THRESHOLD",
      "category": "Pricing",
      "input_field": "discount_pct",
      "operator": ">",
      "threshold": 20,
      "upper_bound": 25,
      "unit": "percent",
      "status": "EXCEPTION",
      "severity": "HIGH",
      "exception_type": "PRICING_EXCEPTION",
      "approver_function": "Deal Desk",
      "approver_level": "Senior Deal Manager",
      "approval_priority": 20,
      "documentation_required": true,
      "message_template": "Discount is {actual_value}%, above standard commercial authority of 20%.",
      "remediation": {"action": "Reduce discount to 20% or below, or document the pricing exception", "target_value": 20}
    },
    {
      "rule_id": "DISC_GT_25",
      "policy_id": "DISCOUNT_THRESHOLD",
      "category": "Pricing",
      "input_field": "discount_pct",
      "operator": ">",
      "threshold": 25,
      "upper_bound": 30,
      "unit": "percent",
      "status": "EXCEPTION",
      "severity": "HIGH",
      "exception_type": "PRICING_EXCEPTION",
      "approver_function": "Finance",
      "approver_level": "Finance Director",
      "approval_priority": 30,
      "documentation_required": true,
      "message_template": "Discount is {actual_value}%, which exceeds the 25% exception threshold.",
      "remediation": {"action": "Reduce discount to 25% or below", "target_value": 25}
    },
    {
      "rule_id": "DISC_GT_30",
      "policy_id": "DISCOUNT_THRESHOLD",
      "category": "Pricing",
      "input_field": "discount_pct",
      "operator": ">",
      "threshold": 30,
      "unit": "percent",
      "status": "BLOCK",
      "severity": "CRITICAL",
      "exception_type": "PRICING_EXCEPTION",
      "approver_function": "Executive",
      "approver_level": "VP Commercial",
      "approval_priority": 50,
      "documentation_required": true,
      "message_template": "Discount is {actual_value}%, above the executive commercial threshold of 30%.",
      "remediation": {"action": "Reduce discount to 30% or below before standard approval routing", "target_value": 30}
    },
    {
      "rule_id": "TCV_GT_5M",
      "policy_id": "DEAL_SIZE",
      "category": "Deal Size",
      "input_field": "tcv",
      "operator": ">",
      "threshold": 5000000,
      "unit": "usd",
      "status": "REVIEW",
      "severity": "MEDIUM",
      "exception_type": "DEAL_SIZE_REVIEW",
      "approver_function": "Deal Desk",
      "approver_level": "Senior Deal Manager",
      "approval_priority": 20,
      "documentation_required": false,
      "message_template": "TCV is ${actual_value}, above the $5M commercial review threshold.",
      "remediation": {"action": "No remediation required; commercial review is required for deal size", "target_value": 5000000}
    },
    {
      "rule_id": "TCV_GT_10M",
      "policy_id": "DEAL_SIZE",
      "category": "Deal Size",
      "input_field": "tcv",
      "operator": ">",
      "threshold": 10000000,
      "unit": "usd",
      "status": "EXCEPTION",
      "severity": "HIGH",
      "exception_type": "DEAL_SIZE_REVIEW",
      "approver_function": "Finance",
      "approver_level": "Finance Director",
      "approval_priority": 30,
      "documentation_required": true,
      "message_template": "TCV is ${actual_value}, above the $10M finance leadership threshold.",
      "remediation": {"action": "No remediation required; finance leadership review is required for deal size", "target_value": 10000000}
    },
    {
      "rule_id": "TERM_STANDARD",
      "policy_id": "CONTRACT_TERM",
      "category": "Contract Term",
      "input_field": "contract_term_months",
      "operator": "between",
      "threshold": 12,
      "upper_bound": 36,
      "unit": "months",
      "status": "PASS",
      "severity": "LOW",
      "message_template": "Contract term is {actual_value} months, within the standard 12-36 month range."
    },
    {
      "rule_id": "TERM_GT_36",
      "policy_id": "CONTRACT_TERM",
      "category": "Contract Term",
      "input_field": "contract_term_months",
      "operator": ">",
      "threshold": 36,
      "unit": "months",
      "status": "REVIEW",
      "severity": "MEDIUM",
      "exception_type": "CONTRACT_TERM_EXCEPTION",
      "approver_function": "Legal",
      "approver_level": "Commercial Counsel",
      "approval_priority": 40,
      "documentation_required": true,
      "message_template": "Contract term is {actual_value} months, above the standard 36-month range.",
      "remediation": {"action": "Reduce contract term to 36 months or below", "target_value": 36}
    },
    {
      "rule_id": "PAYMENT_NET_60",
      "policy_id": "PAYMENT_TERMS",
      "category": "Payment Terms",
      "input_field": "payment_terms_days",
      "operator": ">",
      "threshold": 45,
      "upper_bound": 60,
      "unit": "days",
      "status": "REVIEW",
      "severity": "MEDIUM",
      "exception_type": "PAYMENT_TERM_EXCEPTION",
      "approver_function": "Finance",
      "approver_level": "Finance Manager",
      "approval_priority": 25,
      "documentation_required": true,
      "message_template": "Payment terms are Net {actual_value}, above standard Net 45.",
      "remediation": {"action": "Move payment terms to Net 45 or better", "target_value": 45}
    },
    {
      "rule_id": "PAYMENT_GT_60",
      "policy_id": "PAYMENT_TERMS",
      "category": "Payment Terms",
      "input_field": "payment_terms_days",
      "operator": ">",
      "threshold": 60,
      "unit": "days",
      "status": "EXCEPTION",
      "severity": "HIGH",
      "exception_type": "PAYMENT_TERM_EXCEPTION",
      "approver_function": "Finance",
      "approver_level": "Finance Director",
      "approval_priority": 30,
      "documentation_required": true,
      "message_template": "Payment terms are Net {actual_value}, above the Net 60 exception threshold.",
      "remediation": {"action": "Move payment terms to Net 60 or better", "target_value": 60}
    },
    {
      "rule_id": "COMMITMENT_COVERAGE",
      "policy_id": "CONSUMPTION_COMMITMENT",
      "category": "Commitment",
      "input_field": "coverage_ratio",
      "operator": "<",
      "threshold": 1,
      "unit": "ratio",
      "status": "REVIEW",
      "severity": "HIGH",
      "exception_type": "COMMITMENT_EXCEPTION",
      "approver_function": "Deal Desk",
      "approver_level": "Senior Deal Manager",
      "approval_priority": 20,
      "documentation_required": true,
      "message_template": "Expected consumption covers {actual_value}x of commitment, below full coverage.",
      "remediation": {"action": "Reduce commitment or increase expected consumption until coverage is at least 1.00x", "target_value": 1}
    },
    {
      "rule_id": "NPV_POSITIVE",
      "policy_id": "FINANCIAL_RETURN",
      "category": "Financial Return",
      "input_field": "npv",
      "operator": ">=",
      "threshold": 0,
      "unit": "usd",
      "status": "PASS",
      "severity": "LOW",
      "message_template": "NPV is positive at ${actual_value}."
    },
    {
      "rule_id": "NPV_NEGATIVE",
      "policy_id": "FINANCIAL_RETURN",
      "category": "Financial Return",
      "input_field": "npv",
      "operator": "<",
      "threshold": 0,
      "unit": "usd",
      "status": "BLOCK",
      "severity": "CRITICAL",
      "exception_type": "FINANCIAL_RETURN_EXCEPTION",
      "approver_function": "Finance",
      "approver_level": "Finance Director",
      "approval_priority": 30,
      "documentation_required": true,
      "message_template": "NPV is negative at ${actual_value}.",
      "remediation": {"action": "Improve scenario economics until NPV is positive", "target_value": 0}
    },
    {
      "rule_id": "PRICE_PROTECTION_36",
      "policy_id": "LEGAL_TERMS",
      "category": "Legal Terms",
      "input_field": "price_protection_months",
      "operator": ">=",
      "threshold": 36,
      "unit": "months",
      "status": "REVIEW",
      "severity": "MEDIUM",
      "exception_type": "LEGAL_TERM_EXCEPTION",
      "approver_function": "Legal",
      "approver_level": "Commercial Counsel",
      "approval_priority": 40,
      "documentation_required": true,
      "message_template": "Price protection is {actual_value} months and requires legal/commercial review.",
      "remediation": {"action": "Limit price protection to committed term and named workloads", "target_value": 36}
    },
    {
      "rule_id": "GROSS_MARGIN_NOT_MODELED",
      "policy_id": "GROSS_MARGIN",
      "category": "Financial Return",
      "input_field": "gross_margin_pct",
      "operator": "is_null",
      "threshold": null,
      "unit": "percent",
      "status": "NOT_MODELED",
      "severity": "LOW",
      "message_template": "Gross margin is not modeled by the existing deterministic financial engine."
    }
  ]
}
